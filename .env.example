# Public domain for HTTPS, CORS, and OAuth (e.g., twentys1x.example.com).
# In local dev, leave as localhost or set to your local IP.
DOMAIN=localhost

# Browser-side Sentry. Leave empty to disable external browser error monitoring.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=local
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Node backend Sentry. Leave empty to disable external server error monitoring.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0

# Auth token signing. Set a strong random value in production.
AUTH_TOKEN_SECRET=

# Primary persistence. Local dev can stay empty/SQLite; production should use PostgreSQL.
# Examples:
#   APP_DATABASE_URL=sqlite:./data/app.sqlite
#   APP_DATABASE_URL=postgresql://pet_ai:change-me@postgres:5432/pet_ai
APP_DATABASE_URL=
APP_DATABASE_SSL=false
APP_DATABASE_POOL_SIZE=10

# Redis stores short-lived state: SMS codes, OAuth state/tickets, lockouts, and API rate limits.
REDIS_URL=
REDIS_KEY_PREFIX=pet-ai

# S3-compatible object storage for pet avatars, medical files, and chat attachments.
# Works with AWS S3, Cloudflare R2, MinIO, Alibaba OSS S3-compatible endpoints, Tencent COS S3-compatible endpoints, etc.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Real SMS delivery. Twentys1x POSTs
# { phone, code, purpose, expiresInSeconds } to this webhook.
AUTH_SMS_WEBHOOK_URL=
AUTH_SMS_WEBHOOK_TOKEN=

# Or use Alibaba Cloud SMS directly.
AUTH_ALIYUN_SMS_ACCESS_KEY_ID=
AUTH_ALIYUN_SMS_ACCESS_KEY_SECRET=
AUTH_ALIYUN_SMS_SIGN_NAME=
AUTH_ALIYUN_SMS_TEMPLATE_CODE=
AUTH_ALIYUN_SMS_TEMPLATE_PARAM_NAME=code

# OAuth callback origins. In Vite dev, http://localhost:5174 is usually correct.
AUTH_PUBLIC_BASE_URL=http://localhost:5174
AUTH_CLIENT_BASE_URL=http://localhost:5174

# WeChat QR OAuth.
AUTH_WECHAT_CLIENT_ID=
AUTH_WECHAT_CLIENT_SECRET=
AUTH_WECHAT_SCOPE=snsapi_login

# QQ OAuth.
AUTH_QQ_CLIENT_ID=
AUTH_QQ_CLIENT_SECRET=
AUTH_QQ_SCOPE=get_user_info
