{
  "name": "twentys1x-kimi-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node server/index.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "security:audit": "npm audit --audit-level=moderate --registry=https://registry.npmjs.org",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@sentry/node": "^10.50.0",
    "@sentry/vue": "^10.50.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "dompurify": "^3.4.1",
    "element-plus": "^2.13.7",
    "localforage": "^1.10.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.2",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.7",
    "vue-virtual-scroller": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/prismjs": "^1.26.6",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
